# Server Configuration
PORT=8002
PYTHON_ENV=development
# Database Configuration (in production, traffic is routed through PgBouncer)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=core_auth_db
DB_USER=core_auth_user
DB_PASSWORD=dev_password
# Loki (Optional for local development)
LOKI_ENDPOINT=http://localhost:3100/otlp/v1/logs

# JWT Configuration
JWT_SECRET=local-development-secret

# SMTP (email delivery for 2FA codes and password reset)
# For local dev: run `python -m aiosmtpd -n -l localhost:1025` to capture outgoing mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Use TLS (port 465) OR STARTTLS (port 587), never both
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
MAIL_FROM=noreply@supreme.local
MAIL_FROM_NAME=Supreme
APP_BASE_URL=http://localhost:3000

